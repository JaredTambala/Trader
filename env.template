# Local MCP server environment.
# Copy this file to local.env and edit local values there.
# local.env is intentionally ignored by git.

TRADER_MCP_ENVIRONMENT=local
TRADER_MCP_TRANSPORT=stdio
TRADER_MCP_ARTIFACT_ROOT=artifacts/research

# Optional trader YAML config used by MCP data tools to build a real event store.
# Leave empty for no-op/default local data behavior.
TRADER_MCP_TRADER_CONFIG_PATH=

# Optional dotenv file loaded only when a tool builds the trader YAML above.
# This is the same runtime env file used by run_*.py entrypoints for ${...} expansion.
TRADER_MCP_TOOL_ENV_PATH=.env

# Safety gates. Keep broker mutation and raw SQL disabled.
TRADER_MCP_ALLOW_BROKER_MUTATION=false
TRADER_MCP_ALLOW_RAW_SQL=false
TRADER_MCP_ALLOW_SYMBOL_PROVIDER_DISCOVERY=false
TRADER_MCP_ALLOW_DATA_LOADING=false
TRADER_MCP_ALLOW_BACKTESTS=false
TRADER_MCP_ALLOW_ML_RUNTIME=false

# Strategy Engineering Coding Workspace. Keep disabled until all four pinned
# values are configured. Candidate checks use a networkless, read-only,
# capability-dropped container; generated source is never run on the host.
TRADER_MCP_ALLOW_CODING_WORKSPACE=false
TRADER_MCP_CODING_WORKSPACE_ROOT=
TRADER_MCP_CODING_REPOSITORY_ROOT=
TRADER_MCP_CODING_REPOSITORY_REVISION=
TRADER_MCP_CODING_CONTAINER_IMAGE=

# Optional local MLflow python_function inference profile. Model loading occurs
# only when the ML runtime gate is enabled; model aliases are resolved upstream.
MLFLOW_TRACKING_URI=
TRADER_MLFLOW_INFERENCE_PROFILE=mlflow_local_pyfunc

# Knowledge metadata/chunk/embedding storage backend. Production uses Postgres
# through TRADER_MCP_TRADER_CONFIG_PATH; tests may inject a store directly.
TRADER_RESEARCH_KNOWLEDGE_STORE=postgres

# Quant Methods knowledge embedding runtime.
# Leave provider empty to make document ingestion fail fast until configured.
# Supported provider values today: openai, openai_compatible.
TRADER_RESEARCH_EMBEDDINGS_PROVIDER=
TRADER_RESEARCH_EMBEDDINGS_MODEL=
TRADER_RESEARCH_EMBEDDINGS_BASE_URL=
TRADER_RESEARCH_EMBEDDINGS_API_KEY=
TRADER_RESEARCH_EMBEDDINGS_TIMEOUT_SECONDS=30

# Data Agent LLM policy runtime.
# Leave provider empty to make the LLM policy graph fail fast until configured.
# Supported provider values today: openrouter, openai_compatible, ollama.
TRADER_AGENTS_LLM_PROVIDER=
TRADER_AGENTS_LLM_MODEL=
TRADER_AGENTS_LLM_BASE_URL=
TRADER_AGENTS_LLM_API_KEY=
TRADER_AGENTS_LLM_TIMEOUT_SECONDS=30

# Dedicated LangGraph operational checkpoint connection. This may target the
# Trader Postgres instance or a separately governed database/schema. Checkpoint
# rows are resumability state, not canonical research evidence.
TRADER_AGENTS_CHECKPOINT_DSN=

# Controlled qualification only. The orchestration profile requires a dedicated
# non-superuser role targeting PG_TEST_DB and owning only TRADER_CHECKPOINT_SCHEMA.
TRADER_VERIFICATION_PROFILE=
TRADER_CHECKPOINT_SCHEMA=orchestration_checkpoint
PG_CHECKPOINT_TEST_HOST=
PG_CHECKPOINT_TEST_PORT=5432
PG_CHECKPOINT_TEST_DB=
PG_CHECKPOINT_TEST_USER=
PG_CHECKPOINT_TEST_PASSWORD=
